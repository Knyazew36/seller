{
  "name": "@app/support-chat-react",
  "version": "0.1.0",
  "private": true,
  "description": "React-компоненты чата поддержки: виджет посетителя и инбокс оператора. Стили — Tailwind с префиксом scw: на переменных --scw-*, собираются в свой CSS без зависимости от UI-кита проекта",
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "README.md",
    "examples"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tailwindcss -i src/styles.css -o dist/styles.css --minify",
    "dev": "node scripts/dev.mjs",
    "check-types": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@app/support-chat-client": "0.1.0"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "4.3.3",
    "typescript": "^6"
  }
}
