  "paths": {
    "/api/1/partner/tariff/info": {
      "get": {
        "description": "Возвращает информацию о текущем тарифе пользователя, включая остатки размещений\nпо пакетам тарифа (LF).\n\n**Данный метод доступен только пользователям с платным тарифом (Профи или Лидер) в недвижимости**\n",
        "operationId": "GetTariffInfo",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetTariffInfoOut"
                }
              }
            },
            "description": "Успешный ответ"
          },
          "400": {
            "$ref": "#/components/responses/400"
          },
          "401": {
            "$ref": "#/components/responses/401"
          },
          "403": {
            "$ref": "#/components/responses/403"
          },
          "500": {
            "$ref": "#/components/responses/500"
          }
        },
        "security": [
          {
            "ClientCredentials": []
          }
        ],
        "summary": "Информация о текущем тарифе пользователя"
      },
      "x-format": "avito:api@v3"
    }
